# Tostoes API — public_html (cPanel / Apache)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Bloquear listagem de diretórios
  Options -Indexes

  # Apache/CGI remove Authorization — repassar para o PHP
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Arquivos e pastas reais
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # API: /api/... e rotas na raiz → index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Bloquear arquivos sensíveis
<FilesMatch "^(\.env|\.env\.|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

<Files ".env">
  Require all denied
</Files>
