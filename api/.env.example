# API no Docker — copie para .env: cp .env.example .env
# MySQL sobe no compose (serviço mysql); a API usa o hostname interno "mysql".

DB_HOST=mysql
DB_PORT=3306
DB_NAME=gastos
DB_USER=root
DB_PASS=root

JWT_SECRET=local-dev-secret-change-me
CORS_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200
APP_TIMEZONE=America/Sao_Paulo
MAIL_DRIVER=log
MAIL_FROM=Tostoes <noreply@tostoes.app>
