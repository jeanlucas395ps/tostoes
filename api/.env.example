# Local (Docker): DB_NAME / DB_USER / DB_PASS
# cPanel: DB_DATABASE / DB_USERNAME / DB_PASSWORD (ver .env.hosting.example)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gastos
DB_USER=root
DB_PASS=

JWT_SECRET=troque-este-segredo
# Origem do frontend (local ou Vercel). Em produção: https://tostoes.com.br (ou seu domínio Vercel)
CORS_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200
APP_TIMEZONE=America/Sao_Paulo
MAIL_DRIVER=log
MAIL_FROM=Tostoes <noreply@tostoes.app>

# Opcional — usuário na primeira migração (Docker: api/.env.docker)
# SETUP_USER=demo
# SETUP_PASSWORD=changeme
# SETUP_NAME=Usuário demo
