# Dev local: API no Docker + MySQL da máquina
# cp .env.example .env  →  docker compose up -d --build
#
# Pré-requisito: MySQL local com banco `tostoes`
#   mysql -u root -proot -e "CREATE DATABASE IF NOT EXISTS tostoes CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#   mysql -u root -proot tostoes < dump.sql

DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=tostoes
DB_USER=root
DB_PASS=root

JWT_SECRET=local-dev-secret-change-me
CORS_ORIGIN=*
APP_URL=http://localhost:4200
APP_NAME=Tostoes
APP_TIMEZONE=America/Sao_Paulo
# log = grava em storage/mail.log | smtp = Hostinger (veja .env.server)
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@tostoes.app
MAIL_FROM_NAME=Tostoes

# Rate limit (arquivo em storage/rate-limit)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_API_PER_HOUR=2000
RATE_LIMIT_API_PER_DAY=10000
# Auth (login/register/forgot/reset),  mais restrito
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_HOUR=200
RATE_LIMIT_AUTH_PER_DAY=500
# true só atrás de proxy confiável (senão X-Forwarded-For pode ser spoofado)
RATE_LIMIT_TRUST_PROXY=false

