# Copie para public_html/.env na Alpha Media (não versionar a senha real).

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=seu_banco
DB_USERNAME=seu_usuario_mysql
DB_PASSWORD=

# Alternativa (também aceita): DB_NAME, DB_USER, DB_PASS

JWT_SECRET=gere-um-segredo-longo-aleatorio-aqui
APP_TIMEZONE=America/Sao_Paulo

# Origens do frontend (vírgula). Curinga: https://*.vercel.app
CORS_ORIGIN=https://tostoes.com.br,https://www.tostoes.com.br,http://localhost:4200,https://*.vercel.app
APP_URL=https://tostoes.com.br

# E-mails (log = só grava em storage/mail.log; smtp se configurar depois)
MAIL_DRIVER=log
MAIL_FROM=Tostoes <noreply@tostoes.app>

# Senha dos usuários seed ao rodar migrate (apenas primeira instalação)
SETUP_PASSWORD=

# --- Sincronizar banco local → cPanel (scripts/sync-db-to-cpanel.sh) ---
# Hostname MySQL remoto (cPanel → MySQL → hostname; NÃO use localhost no Mac)
# REMOTE_DB_HOST=mysql.seudominio.com.br
# SSH (recomendado): importa via servidor
# SSH_HOST=seudominio.com.br
# SSH_USER=seu_usuario_cpanel
# SSH_PORT=22
# SSH_REMOTE_PUBLIC_HTML=public_html
